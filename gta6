        function spawnTrafficAndCars() {
            const carSpecs = [
                { name: 'INFERNUS NEON GT', color: 0xff2a85, maxSpeed: 46 },
                { name: 'CHEETAH VICE TURBO', color: 0x00f0ff, maxSpeed: 48 },
                { name: 'BANSHEE MIAMI V8', color: 0xffbe0b, maxSpeed: 43 },
                { name: 'COMET RETRO S', color: 0xa855f7, maxSpeed: 45 },
                { name: 'STINGER OCEANIC', color: 0x10b981, maxSpeed: 42 }
            ];

            // Spawn a parked VIP Supercar right near the player at start!
            const starterSpec = carSpecs[0];
            const starterMesh = createVehicleMesh(starterSpec.color, false);
            starterMesh.carGroup.position.set(8, 0, 7);
            starterMesh.carGroup.rotation.y = -Math.PI / 4;
            vehicles.push({
                mesh: starterMesh.carGroup,
                name: starterSpec.name,
                speed: 0,
                maxSpeed: starterSpec.maxSpeed,
                steering: 0,
                isAI: false,
                isPolice: false,

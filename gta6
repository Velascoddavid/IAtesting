        // --- PROCEDURAL TEXTURES FOR PRO ULTRA MAX GRAPHICS ---
        function createBuildingFacadeTexture(hueAccent) {
            const c = document.createElement('canvas');
            c.width = 256;
            c.height = 512;
            const ctx = c.getContext('2d');

            // Dark sleek skyscraper glass base
            ctx.fillStyle = '#0e0a1c';
            ctx.fillRect(0, 0, 256, 512);

            const cols = 8;
            const rows = 20;
            const padX = 6;
            const padY = 6;
            const winW = (256 - padX * (cols + 1)) / cols;
            const winH = (512 - padY * (rows + 1)) / rows;

            for (let r = 0; r < rows; r++) {
                for (let col = 0; col < cols; col++) {
                    const lit = Math.random() > 0.35;
                    if (lit) {
                        const rnd = Math.random();
                        if (rnd < 0.25) ctx.fillStyle = hueAccent;
                        else if (rnd < 0.55) ctx.fillStyle = '#ffd685';
                        else if (rnd < 0.8) ctx.fillStyle = '#00f0ff';
                        else ctx.fillStyle = '#ff42a1';
                    } else {
                        ctx.fillStyle = '#17132b';
                    }
                    const x = padX + col * (winW + padX);
                    const y = padY + r * (winH + padY);
                    ctx.fillRect(x, y, winW, winH);
                }
            }

            const tex = new THREE.CanvasTexture(c);
            tex.wrapS = THREE.RepeatWrapping;
            tex.wrapT = THREE.RepeatWrapping;
            return tex;
        }


        // --- HEALTH (VIDA = 100), CASH & WANTED STARS ---
        function updateHealthHUD() {
            const hp = Math.max(0, Math.min(100, Math.round(gameState.health)));
            const ar = Math.max(0, Math.min(100, Math.round(gameState.armor)));
            document.getElementById('hud-health-text').textContent = `${hp} / 100`;
            document.getElementById('hud-health-bar').style.width = `${hp}%`;
            document.getElementById('hud-armor-text').textContent = `${ar} / 100`;
            document.getElementById('hud-armor-bar').style.width = `${ar}%`;
        }

        function restoreFullHealth() {
            gameState.health = 100;
            gameState.armor = 100;
            updateHealthHUD();
            sfx.playPickup();
            showToast('VIDA RESTAURADA A 100 / 100');
        }

        function applyPlayerDamage(amount) {
            if (gameState.isWasted || amount <= 0) return;
            if (gameState.armor > 0) {
                const absorb = Math.min(gameState.armor, amount * 0.65);
                gameState.armor -= absorb;
                gameState.health -= (amount - absorb);
            } else {
                gameState.health -= amount;
            }
            updateHealthHUD();

            const dmgOverlay = document.getElementById('damage-overlay');
            dmgOverlay.style.opacity = '0.75';
            setTimeout(() => { dmgOverlay.style.opacity = '0'; }, 180);

            if (gameState.health <= 0) {
                gameState.health = 0;
                updateHealthHUD();
                triggerWasted();
            }
        }

        function triggerWasted() {
            gameState.isWasted = true;
            if (gameState.inVehicle) exitCurrentVehicle();
            playerGroup.rotation.x = -Math.PI / 2;
            document.getElementById('wasted-screen').classList.remove('hidden');
            document.getElementById('wasted-screen').classList.add('flex');
        }

        function respawnPlayer() {
            gameState.isWasted = false;
            gameState.health = 100;
            gameState.armor = 100;
            updateHealthHUD();
            clearWantedLevel();
            playerGroup.rotation.set(0, 0, 0);
            playerGroup.position.set(0, 0.3, 0);
            document.getElementById('wasted-screen').classList.add('hidden');
            document.getElementById('wasted-screen').classList.remove('flex');
            showToast('ALTA MÉDICA: VIDA = 100 / 100');
        }

        function addCash(amount) {
            gameState.cash += amount;
            document.getElementById('hud-cash').textContent = gameState.cash.toLocaleString('en-US');
        }

        function increaseWantedLevel(delta = 1) {
            const prev = gameState.wantedStars;
            gameState.wantedStars = Math.min(5, gameState.wantedStars + delta);
            gameState.wantedDecayTimer = 28; // Seconds before stars decay
            updateWantedHUD();

            if (gameState.wantedStars > prev) {
                spawnPoliceCruiser();
                showToast(`NIVEL DE BÚSQUEDA: ${gameState.wantedStars} ESTRELLAS`);
            }
        }

        function clearWantedLevel() {
            gameState.wantedStars = 0;
            updateWantedHUD();
            // Remove active police units
            while (policeUnits.length > 0) {
                const cop = policeUnits.pop();
                scene.remove(cop.mesh);
            }
            document.getElementById('siren-overlay').style.opacity = '0';
            showToast('NIVEL DE BÚSQUEDA LIMPIO (0★)');
        }

        function updateWantedHUD() {
            for (let i = 1; i <= 5; i++) {
                const starEl = document.getElementById(`star-${i}`);
                if (i <= gameState.wantedStars) {
                    starEl.className = 'fa-solid fa-star wanted-active';
                } else {
                    starEl.className = 'fa-solid fa-star text-slate-700';
                }
            }
            document.getElementById('siren-overlay').style.opacity = gameState.wantedStars > 0 ? '1' : '0';
        }

        function spawnPoliceCruiser() {
            if (policeUnits.length >= 5) return;
            const targetPos = gameState.inVehicle ? gameState.inVehicle.mesh.position : playerGroup.position;
            const angle = Math.random() * Math.PI * 2;
            const spawnX = targetPos.x + Math.cos(angle) * 55;
            const spawnZ = targetPos.z + Math.sin(angle) * 55;

            const { carGroup, sirenRed, sirenBlue } = createVehicleMesh(0x111827, true);
            carGroup.position.set(spawnX, 0, spawnZ);
            policeUnits.push({
                mesh: carGroup,
                name: 'PATRULLA LEONIDA PD',
                speed: 22,
                maxSpeed: 44,
                isPolice: true,
                health: 120,
                sirenRed,
                sirenBlue,
                shotCooldown: 1.5
            });
        }

        // --- GRAPHICS QUALITY SELECTOR ---
        function cycleGraphicsQuality() {
            const modes = ['ULTRA_MAX', 'ALTO', 'RENDIMIENTO'];
            const labels = {
                ULTRA_MAX: 'PRO ULTRA MAX',
                ALTO: 'ALTO (60 FPS)',
                RENDIMIENTO: 'RENDIMIENTO TURBO'
            };
            const nextIdx = (modes.indexOf(gameState.graphicsMode) + 1) % modes.length;
            gameState.graphicsMode = modes[nextIdx];

            if (gameState.graphicsMode === 'ULTRA_MAX') {
                renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
                renderer.shadowMap.enabled = true;
                scene.fog.density = 0.0026;
            } else if (gameState.graphicsMode === 'ALTO') {
                renderer.setPixelRatio(1.25);
                renderer.shadowMap.enabled = true;
                scene.fog.density = 0.0032;
            } else {
                renderer.setPixelRatio(1.0);
                renderer.shadowMap.enabled = false;
                scene.fog.density = 0.004;
            }

            const label = labels[gameState.graphicsMode];
            document.getElementById('btn-gfx-text').textContent = `Calidad: ${label}`;
            document.getElementById('gfx-badge').innerHTML = `<i class="fa-solid fa-wand-magic-sparkles text-[10px]"></i> GRÁFICOS: ${label}`;
            showToast(`GRÁFICOS AJUSTADOS A: ${label}`);
        }

        function showToast(text) {
            const toast = document.getElementById('event-toast');
            document.getElementById('event-toast-text').textContent = text;
            toast.style.opacity = '1';
            clearTimeout(window._toastTimeout);
            window._toastTimeout = setTimeout(() => {
                toast.style.opacity = '0';
            }, 2600);
        }

        function toggleControlsModal() {
            const modal = document.getElementById('controls-modal');
            if (modal.classList.contains('hidden')) {
                modal.classList.remove('hidden');
                modal.classList.add('flex');
                if (document.pointerLockElement) document.exitPointerLock();
            } else {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
            }
        }

        // --- COLLISION HELPER ---
        function collidesWithBuilding(x, z, radius = 0.9) {
            for (const b of buildingColliders) {
                if (x + radius > b.minX && x - radius < b.maxX && z + radius > b.minZ && z - radius < b.maxZ) {
                    return true;
                }
            }
            return false;
        }

        // --- RADAR / MINIMAP RENDERER ---
        const radarCanvas = document.getElementById('radar-canvas');
        const radarCtx = radarCanvas.getContext('2d');

        function renderRadar() {
            const w = radarCanvas.width;
            const h = radarCanvas.height;
            const center = w / 2;
            const scale = 0.75;

            const refPos = gameState.inVehicle ? gameState.inVehicle.mesh.position : playerGroup.position;

            radarCtx.fillStyle = '#0b0719';
            radarCtx.fillRect(0, 0, w, h);

            radarCtx.save();
            radarCtx.translate(center, center);
            radarCtx.rotate(gameState.cameraYaw);

            // Draw Ocean Shoreline
            const oceanX = (170 - refPos.x) * scale;
            radarCtx.fillStyle = 'rgba(0, 184, 212, 0.35)';
            radarCtx.fillRect(oceanX, -300, 300, 600);

            // Draw City Blocks
            radarCtx.fillStyle = '#251e3e';
            radarCtx.strokeStyle = '#ff2a8555';
            radarCtx.lineWidth = 1;
            for (let gx = -GRID_RADIUS; gx <= GRID_RADIUS; gx++) {
                for (let gz = -GRID_RADIUS; gz <= GRID_RADIUS; gz++) {
                    if (gx === 0 && gz === 0) continue;
                    const bx = (gx * CELL_SIZE - BLOCK_SIZE / 2 - refPos.x) * scale;
                    const bz = (gz * CELL_SIZE - BLOCK_SIZE / 2 - refPos.z) * scale;
                    const bSize = BLOCK_SIZE * scale;
                    radarCtx.fillRect(bx, bz, bSize, bSize);
                    radarCtx.strokeRect(bx, bz, bSize, bSize);
                }
            }

            // Draw Pickups
            pickups.forEach(p => {
                if (!p.active) return;
                const px = (p.mesh.position.x - refPos.x) * scale;
                const pz = (p.mesh.position.z - refPos.z) * scale;
                radarCtx.fillStyle = p.type === 'cash' ? '#10b981' : '#ff2a85';
                radarCtx.fillRect(px - 2, pz - 2, 4, 4);
            });

            // Draw Vehicles
            vehicles.forEach(v => {
                if (v === gameState.inVehicle) return;
                const vx = (v.mesh.position.x - refPos.x) * scale;
                const vz = (v.mesh.position.z - refPos.z) * scale;
                radarCtx.fillStyle = '#00f0ff';
                radarCtx.beginPath();
                radarCtx.arc(vx, vz, 3, 0, Math.PI * 2);
                radarCtx.fill();
            });

            // Draw Police Cruisers (Flashing Red/Blue)
            const flashRed = Math.floor(performance.now() / 220) % 2 === 0;
            policeUnits.forEach(cop => {
                const cx = (cop.mesh.position.x - refPos.x) * scale;
                const cz = (cop.mesh.position.z - refPos.z) * scale;
                radarCtx.fillStyle = flashRed ? '#ff0044' : '#00d9ff';
                radarCtx.beginPath();
                radarCtx.arc(cx, cz, 4.2, 0, Math.PI * 2);
                radarCtx.fill();
            });

            radarCtx.restore();

            // Center Player Arrow
            radarCtx.fillStyle = '#ffffff';
            radarCtx.beginPath();
            radarCtx.moveTo(center, center - 6);
            radarCtx.lineTo(center - 5, center + 5);
            radarCtx.lineTo(center + 5, center + 5);
            radarCtx.closePath();
            radarCtx.fill();

            // Update Zone Name based on coordinates
            const zoneEl = document.getElementById('radar-zone');
            if (refPos.x > 135) zoneEl.textContent = 'VICE BEACH SHORELINE';
            else if (Math.abs(refPos.x) < 40 && Math.abs(refPos.z) < 40) zoneEl.textContent = 'PLAZA CENTRAL LEONIDA';
            else if (refPos.z < -60) zoneEl.textContent = 'DISTRITO DOWNTOWN NEON';
            else zoneEl.textContent = 'OCEAN DRIVE SUR';
        }

        // --- INPUT LISTENERS ---
        window.addEventListener('keydown', (e) => {
            const code = e.code;
            if (code === 'KeyW' || code === 'ArrowUp') keys.w = true;
            if (code === 'KeyS' || code === 'ArrowDown') keys.s = true;
            if (code === 'KeyA' || code === 'ArrowLeft') keys.a = true;
            if (code === 'KeyD' || code === 'ArrowRight') keys.d = true;
            if (code === 'ShiftLeft' || code === 'ShiftRight') keys.shift = true;
            if (code === 'Space') keys.space = true;
            if (code === 'KeyQ') keys.q = true;
            if (code === 'KeyE') {
                keys.e = true;
                interactWithVehicle();
            }
            if (code === 'KeyF') interactWithVehicle();
            if (code === 'KeyJ' || code === 'Enter') keys.shoot = true;
            if (code === 'KeyH' && gameState.inVehicle) sfx.playHorn();
            if (code === 'Digit1') selectWeapon(0);
            if (code === 'Digit2') selectWeapon(1);
            if (code === 'Digit3') selectWeapon(2);
            if (code === 'Digit4') selectWeapon(3);
        });

        window.addEventListener('keyup', (e) => {
            const code = e.code;
            if (code === 'KeyW' || code === 'ArrowUp') keys.w = false;
            if (code === 'KeyS' || code === 'ArrowDown') keys.s = false;
            if (code === 'KeyA' || code === 'ArrowLeft') keys.a = false;
            if (code === 'KeyD' || code === 'ArrowRight') keys.d = false;
            if (code === 'ShiftLeft' || code === 'ShiftRight') keys.shift = false;
            if (code === 'Space') keys.space = false;
            if (code === 'KeyQ') keys.q = false;
            if (code === 'KeyE') keys.e = false;
            if (code === 'KeyJ' || code === 'Enter') keys.shoot = false;
        });

        // Mouse Look & Shooting on Canvas
        canvas.addEventListener('mousedown', (e) => {
            sfx.init();
            if (e.button === 0) {
                keys.shoot = true;
                fireWeapon();
                if (!gameState.pointerLocked && canvas.requestPointerLock) {
                    try { canvas.requestPointerLock(); } catch (err) {}
                }
            }
            gameState.isDraggingMouse = true;
            gameState.previousMousePosition = { x: e.clientX, y: e.clientY };
        });

        window.addEventListener('mouseup', () => {
            keys.shoot = false;
            gameState.isDraggingMouse = false;
        });

        document.addEventListener('pointerlockchange', () => {
            gameState.pointerLocked = (document.pointerLockElement === canvas);
        });

        window.addEventListener('mousemove', (e) => {
            if (gameState.pointerLocked) {
                gameState.cameraYaw -= e.movementX * 0.0026;
                gameState.cameraPitch = Math.max(-0.25, Math.min(0.85, gameState.cameraPitch + e.movementY * 0.0022));
            } else if (gameState.isDraggingMouse) {
                const dx = e.clientX - gameState.previousMousePosition.x;
                const dy = e.clientY - gameState.previousMousePosition.y;
                gameState.cameraYaw -= dx * 0.005;
                gameState.cameraPitch = Math.max(-0.25, Math.min(0.85, gameState.cameraPitch + dy * 0.004));
                gameState.previousMousePosition = { x: e.clientX, y: e.clientY };
            }
        });

        window.addEventListener('wheel', (e) => {
            const next = (gameState.currentWeapon + (e.deltaY > 0 ? 1 : 3)) % 4;
            selectWeapon(next);
        });

        // Touch Controls Binding
        function bindTouchButton(id, keyProp) {
            const el = document.getElementById(id);
            if (!el) return;
            el.addEventListener('touchstart', (e) => { e.preventDefault(); sfx.init(); keys[keyProp] = true; });
            el.addEventListener('touchend', (e) => { e.preventDefault(); keys[keyProp] = false; });
        }
        bindTouchButton('t-up', 'w');
        bindTouchButton('t-down', 's');
        bindTouchButton('t-left', 'a');
        bindTouchButton('t-right', 'd');
        bindTouchButton('t-jump', 'space');
        bindTouchButton('t-shoot', 'shoot');

        window.addEventListener('resize', () => {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        });

        // --- MAIN UPDATE LOOP ---
        let lastFrameTime = performance.now();
        let frameCount = 0;
        let fpsTimer = 0;

        function updateGame(dt) {
            // Rotate camera with Q if needed
            if (keys.q) gameState.cameraYaw += 1.8 * dt;

            // Continuous firing for SMG or held shoot button
            if (keys.shoot && !gameState.inVehicle) {
                fireWeapon();
            }

            // 1. ON-FOOT PLAYER MOVEMENT (Moverte = Disponible)
            if (!gameState.inVehicle && !gameState.isWasted) {
                const moveSpeed = keys.shift ? 15.5 : 9.5;
                let moveX = 0;
                let moveZ = 0;
                if (keys.w) moveZ -= 1;
                if (keys.s) moveZ += 1;
                if (keys.a) moveX -= 1;
                if (keys.d) moveX += 1;

                const isMoving = (moveX !== 0 || moveZ !== 0);
                if (isMoving) {
                    const inputAngle = Math.atan2(moveX, moveZ);
                    const targetYaw = gameState.cameraYaw + inputAngle;
                    const vx = Math.sin(targetYaw) * moveSpeed * dt;
                    const vz = Math.cos(targetYaw) * moveSpeed * dt;

                    const nextX = playerGroup.position.x + vx;
                    const nextZ = playerGroup.position.z + vz;

                    if (!collidesWithBuilding(nextX, playerGroup.position.z, 0.85)) {
                        playerGroup.position.x = Math.max(-290, Math.min(290, nextX));
                    }
                    if (!collidesWithBuilding(playerGroup.position.x, nextZ, 0.85)) {
                        playerGroup.position.z = Math.max(-290, Math.min(290, nextZ));
                    }

                    // Face direction of movement smoothly
                    playerGroup.rotation.y = targetYaw + Math.PI;

                    // Procedural limb swing animation
                    gameState.walkCycle += dt * (keys.shift ? 15 : 10);
                    const swing = Math.sin(gameState.walkCycle) * 0.65;
                    leftLeg.rotation.x = swing;
                    rightLeg.rotation.x = -swing;
                    leftArm.rotation.x = -swing * 0.7;
                } else {
                    leftLeg.rotation.x *= 0.85;
                    rightLeg.rotation.x *= 0.85;
                    leftArm.rotation.x *= 0.85;
                }

                // Jump & Gravity
                if (keys.space && gameState.isGrounded) {
                    gameState.playerVelocityY = 9.5;
                    gameState.isGrounded = false;
                }
                if (!gameState.isGrounded) {
                    playerGroup.position.y += gameState.playerVelocityY * dt;
                    gameState.playerVelocityY -= 24 * dt;
                    if (playerGroup.position.y <= 0.3) {
                        playerGroup.position.y = 0.3;
                        gameState.playerVelocityY = 0;
                        gameState.isGrounded = true;
                    }
                }

                // Check nearby car to show contextual [F] / [E] prompt
                const nearCar = findNearestVehicle(6.5);
                const promptEl = document.getElementById('interaction-prompt');
                if (nearCar) {
                    promptEl.style.opacity = '1';
                    document.getElementById('interaction-text').textContent = `Conducir ${nearCar.name || 'Vehículo'}`;
                } else {
                    promptEl.style.opacity = '0';
                }
            } else {
                document.getElementById('interaction-prompt').style.opacity = '0';
            }

            // 2. PLAYER VEHICLE DRIVING PHYSICS
            if (gameState.inVehicle && !gameState.isWasted) {
                const car = gameState.inVehicle;
                const accel = 28;
                const brake = 35;

                if (keys.w) {
                    car.speed = Math.min(car.maxSpeed, car.speed + accel * dt);
                } else if (keys.s) {
                    car.speed = Math.max(-18, car.speed - brake * dt);
                } else {
                    car.speed *= Math.pow(0.25, dt);
                }

                // Handbrake Drift with Spacebar
                if (keys.space) {
                    car.speed *= Math.pow(0.08, dt);
                    if (Math.abs(car.speed) > 10) {
                        spawnParticles(car.mesh.position.clone().add(new THREE.Vector3(0, 0.2, 0)), 0xd1d5db, 2, 3, 0.25);
                    }
                }

                // Steering
                if (Math.abs(car.speed) > 0.6) {
                    const turnFactor = (keys.space ? 2.8 : 2.1) * Math.sign(car.speed);
                    if (keys.a) car.mesh.rotation.y += turnFactor * dt;
                    if (keys.d) car.mesh.rotation.y -= turnFactor * dt;
                }

                const forward = new THREE.Vector3(
                    Math.sin(car.mesh.rotation.y),
                    0,
                    Math.cos(car.mesh.rotation.y)
                );
                const nextPos = car.mesh.position.clone().add(forward.multiplyScalar(car.speed * dt));

                if (!collidesWithBuilding(nextPos.x, nextPos.z, 2.1)) {
                    car.mesh.position.copy(nextPos);
                } else {
                    // Building crash bounce + sparks
                    car.speed = -car.speed * 0.45;
                    spawnParticles(car.mesh.position, 0xffbe0b, 10, 9, 0.22);
                }

                // Keep player synced with vehicle
                playerGroup.position.copy(car.mesh.position);

                // Auto-align camera gently behind car while driving
                if (!gameState.isDraggingMouse && !gameState.pointerLocked) {
                    const desiredYaw = car.mesh.rotation.y + Math.PI;
                    const diff = Math.atan2(Math.sin(desiredYaw - gameState.cameraYaw), Math.cos(desiredYaw - gameState.cameraYaw));
                    gameState.cameraYaw += diff * 3.5 * dt;
                }

                // Update Speedometer HUD
                const kmh = Math.round(Math.abs(car.speed) * 3.8);
                document.getElementById('speed-value').textContent = kmh;
                document.getElementById('speed-bar').style.width = `${Math.min(100, (kmh / 200) * 100)}%`;

                // Check roadkill / hitting NPCs at speed
                if (Math.abs(car.speed) > 8) {
                    npcs.forEach(npc => {
                        if (npc.alive && npc.mesh.position.distanceTo(car.mesh.position) < 2.6) {
                            killNPC(npc);
                            spawnParticles(npc.mesh.position, 0xff0055, 10, 8, 0.22);
                            increaseWantedLevel(1);
                        }
                    });
                }
            }

            // 3. AI TRAFFIC CARS UPDATE
            vehicles.forEach(v => {
                if (!v.isAI || v === gameState.inVehicle) return;
                const fwd = new THREE.Vector3(Math.sin(v.mesh.rotation.y), 0, Math.cos(v.mesh.rotation.y));
                v.mesh.position.add(fwd.multiplyScalar(v.speed * dt));
                if (Math.abs(v.mesh.position.x) > 190 || Math.abs(v.mesh.position.z) > 190) {
                    v.mesh.rotation.y += Math.PI;
                }
            });

            // 4. NPC PEDESTRIANS UPDATE
            npcs.forEach(npc => {
                if (!npc.alive) return;
                const speed = npc.panicTimer > 0 ? 7.5 : 2.4;
                if (npc.panicTimer > 0) npc.panicTimer -= dt;
                npc.mesh.position.z += npc.walkDir * speed * dt;
                if (Math.abs(npc.mesh.position.z) > 175) npc.walkDir *= -1;
            });

            // 5. POLICE PURSUIT AI & SIRENS
            const sirenToggle = Math.floor(performance.now() / 180) % 2 === 0;
            if (gameState.wantedStars > 0) {
                sfx.playSirenBlip(sirenToggle);
                gameState.wantedDecayTimer -= dt;
                if (gameState.wantedDecayTimer <= 0) {
                    clearWantedLevel();
                }
            }

            const playerPos = gameState.inVehicle ? gameState.inVehicle.mesh.position : playerGroup.position;
            policeUnits.forEach(cop => {
                if (cop.sirenRed && cop.sirenBlue) {
                    cop.sirenRed.material.color.setHex(sirenToggle ? 0xff0044 : 0x330011);
                    cop.sirenBlue.material.color.setHex(!sirenToggle ? 0x00d9ff : 0x001a33);
                }

                const toPlayer = new THREE.Vector3().subVectors(playerPos, cop.mesh.position);
                toPlayer.y = 0;
                const dist = toPlayer.length();

                if (dist > 6.5) {
                    const targetAngle = Math.atan2(toPlayer.x, toPlayer.z);
                    cop.mesh.rotation.y = targetAngle;
                    const moveStep = toPlayer.normalize().multiplyScalar(25 * dt);
                    const nextX = cop.mesh.position.x + moveStep.x;
                    const nextZ = cop.mesh.position.z + moveStep.z;
                    if (!collidesWithBuilding(nextX, nextZ, 2.0)) {
                        cop.mesh.position.x = nextX;
                        cop.mesh.position.z = nextZ;
                    }
                } else {
                    // Police shoots at player when close
                    cop.shotCooldown -= dt;
                    if (cop.shotCooldown <= 0) {
                        cop.shotCooldown = 1.35;
                        sfx.playShot('pistol');
                        applyPlayerDamage(6);
                    }
                }
            });

            // 6. COLLECTIBLE PICKUPS (CASH & VIDA=100 HEALTH)
            pickups.forEach(p => {
                if (!p.active) {
                    p.respawnTimer -= dt;
                    if (p.respawnTimer <= 0) {
                        p.active = true;
                        p.mesh.visible = true;
                    }
                    return;
                }
                p.mesh.rotation.y += 2.4 * dt;
                if (p.mesh.position.distanceTo(playerPos) < 2.6) {
                    p.active = false;
                    p.mesh.visible = false;
                    p.respawnTimer = 18;
                    sfx.playPickup();
                    if (p.type === 'cash') {
                        addCash(500);
                        showToast('+$500 EFECTIVO RECOGIDO');
                    } else {
                        gameState.health = 100;
                        updateHealthHUD();
                        showToast('BOTIQUÍN: VIDA RESTAURADA A 100 / 100');
                    }
                }
            });

            // 7. RPG ROCKET PROJECTILES
            for (let i = rockets.length - 1; i >= 0; i--) {
                const r = rockets[i];
                r.mesh.position.addScaledVector(r.vel, dt);
                r.life -= dt;
                spawnParticles(r.mesh.position, 0xff9900, 1, 2, 0.2);

                const hitGround = r.mesh.position.y <= 0.3;
                const hitBldg = collidesWithBuilding(r.mesh.position.x, r.mesh.position.z, 0.5);
                if (hitGround || hitBldg || r.life <= 0) {
                    triggerExplosion(r.mesh.position);
                    scene.remove(r.mesh);
                    rockets.splice(i, 1);
                }
            }

            // 8. PARTICLES UPDATE
            for (let i = particles.length - 1; i >= 0; i--) {
                const p = particles[i];
                p.mesh.position.addScaledVector(p.vel, dt);
                p.vel.y -= 18 * dt;
                p.life -= dt;
                p.mesh.scale.multiplyScalar(0.95);
                if (p.life <= 0) {
                    scene.remove(p.mesh);
                    particles.splice(i, 1);
                }
            }

            // 9. CAMERA THIRD-PERSON SMOOTH FOLLOW
            const targetFocus = playerPos.clone().add(new THREE.Vector3(0, gameState.inVehicle ? 1.8 : 1.75, 0));
            const speedPullback = gameState.inVehicle ? Math.abs(gameState.inVehicle.speed) * 0.11 : 0;
            const camDist = (gameState.inVehicle ? 9.5 : 5.8) + speedPullback;

            const camOffset = new THREE.Vector3(
                Math.sin(gameState.cameraYaw) * Math.cos(gameState.cameraPitch) * camDist,
                Math.sin(gameState.cameraPitch) * camDist + 0.8,
                Math.cos(gameState.cameraYaw) * Math.cos(gameState.cameraPitch) * camDist
            );

            const desiredCamPos = targetFocus.clone().add(camOffset);
            desiredCamPos.y = Math.max(1.2, desiredCamPos.y);
            camera.position.lerp(desiredCamPos, Math.min(1, dt * 14));
            camera.lookAt(targetFocus);
        }

        function animate(now) {
            requestAnimationFrame(animate);
            const dt = Math.min(0.05, (now - lastFrameTime) / 1000);
            lastFrameTime = now;

            // FPS Counter
            frameCount++;
            fpsTimer += dt;
            if (fpsTimer >= 0.5) {
                const fps = Math.min(144, Math.round(frameCount / fpsTimer));
                document.getElementById('fps-counter').textContent = `${fps} FPS`;
                frameCount = 0;
                fpsTimer = 0;
            }

            updateGame(dt);
            renderRadar();
            renderer.render(scene, camera);
        }

        // --- INITIALIZE GAME ON LOAD ---
        window.onload = function () {
            buildOpenWorld();
            buildPlayerCharacter();
            spawnTrafficAndCars();
            spawnPedestrians(28);
            selectWeapon(1);
            updateHealthHUD();
            showToast('GTA VI LEONIDA • VIDA = 100 • MOVERTE = DISPONIBLE');
            requestAnimationFrame(animate);
        };
    </script>
</body>
</html>

                }
                vehicles.push({
                    mesh: carGroup,
                    name: spec.name,
                    speed: 14 + Math.random() * 6,
                    maxSpeed: spec.maxSpeed,
                    steering: 0,
                    isAI: true,
                    isPolice: false,
                    health: 100
                });
            }
        }

        // --- NPC PEDESTRIANS ---
        function spawnPedestrians(count = 28) {
            const shirtColors = [0xff2a85, 0x00f0ff, 0xfacc15, 0xa855f7, 0x34d399, 0xfb7185];
            for (let i = 0; i < count; i++) {
                const npcGroup = new THREE.Group();
                const shirtColor = shirtColors[i % shirtColors.length];
                const body = new THREE.Mesh(
                    new THREE.BoxGeometry(0.65, 1.25, 0.38),
                    new THREE.MeshStandardMaterial({ color: shirtColor, roughness: 0.5 })
                );
                body.position.y = 1.05;
                body.castShadow = true;
                npcGroup.add(body);

                const head = new THREE.Mesh(
                    new THREE.BoxGeometry(0.42, 0.42, 0.42),
                    new THREE.MeshStandardMaterial({ color: 0xd9a17c })
                );
                head.position.y = 1.92;
                npcGroup.add(head);

                // Place on sidewalks outside buildings
                const roadIdx = Math.floor(Math.random() * (GRID_RADIUS * 2 + 1)) - GRID_RADIUS;
                const x = roadIdx * CELL_SIZE + ( BLOCK_SIZE / 2 - 1.2 );
                const z = (Math.random() - 0.5) * 220;
                npcGroup.position.set(x, 0.25, z);
                npcGroup.rotation.y = Math.random() * Math.PI * 2;
                scene.add(npcGroup);

                npcs.push({
                    mesh: npcGroup,
                    health: 40,
                    alive: true,
                    panicTimer: 0,
                    walkDir: Math.random() > 0.5 ? 1 : -1
                });

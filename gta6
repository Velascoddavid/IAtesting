<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>GTA VI: Leonida Neon — Pro Ultra Max Edition</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Three.js r128 -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@600;800;900&family=Rajdhani:wght@500;600;700&family=Inter:wght@400;600;800&display=swap" rel="stylesheet">
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        * {
            user-select: none;
            -webkit-user-select: none;
            box-sizing: border-box;
        }
        body, html {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100%;
            overflow: hidden;
            background-color: #090414;
            font-family: 'Rajdhani', 'Inter', sans-serif;
        }
        #game-canvas {
            display: block;
            width: 100vw;
            height: 100vh;
            cursor: crosshair;
        }
        .font-gta {
            font-family: 'Orbitron', sans-serif;
            letter-spacing: 0.06em;
        }
        .neon-text-pink {
            text-shadow: 0 0 10px rgba(255, 42, 133, 0.85), 0 0 25px rgba(255, 42, 133, 0.45);
        }
        .neon-text-cyan {
            text-shadow: 0 0 10px rgba(0, 240, 255, 0.85), 0 0 25px rgba(0, 240, 255, 0.45);
        }
        .neon-border {
            box-shadow: 0 0 20px rgba(255, 42, 133, 0.25), inset 0 0 12px rgba(0, 240, 255, 0.12);
        }
        .hud-glass {
            background: rgba(12, 8, 26, 0.78);
            backdrop-filter: blur(10px);
            -webkit-backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.14);
        }
        @keyframes pulse-siren {
            0%, 100% { color: #ff2a55; text-shadow: 0 0 14px #ff2a55; transform: scale(1.08); }
            50% { color: #00e1ff; text-shadow: 0 0 14px #00e1ff; transform: scale(1.0); }
        }
        .wanted-active {
            animation: pulse-siren 0.55s infinite ease-in-out;
        }
        @keyframes damage-flash {
            0% { opacity: 0.65; }
            100% { opacity: 0; }
        }
        .crosshair-ring {
            transition: transform 0.08s ease-out, border-color 0.12s ease;
        }
        /* Scrollbar hide */
        ::-webkit-scrollbar { display: none; }
    </style>
</head>
<body class="text-white antialiased">

    <!-- 3D WebGL Canvas -->
    <canvas id="game-canvas"></canvas>

    <!-- Damage Vignette Flash -->
    <div id="damage-overlay" class="fixed inset-0 pointer-events-none z-10 opacity-0 transition-opacity duration-200"
         style="background: radial-gradient(circle, transparent 45%, rgba(255, 0, 68, 0.65) 100%);"></div>

    <!-- Police Siren Screen Edge Glow -->
    <div id="siren-overlay" class="fixed inset-0 pointer-events-none z-10 opacity-0 transition-opacity duration-300"
         style="background: linear-gradient(90deg, rgba(255,0,64,0.18) 0%, transparent 25%, transparent 75%, rgba(0,195,255,0.18) 100%);"></div>

    <!-- Center Crosshair -->
    <div id="crosshair" class="fixed top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 pointer-events-none z-20 flex items-center justify-center">
        <div id="crosshair-ring" class="crosshair-ring w-7 h-7 rounded-full border-2 border-cyan-400/80 flex items-center justify-center shadow-[0_0_10px_rgba(0,240,255,0.6)]">
            <div class="w-1.5 h-1.5 rounded-full bg-pink-500 shadow-[0_0_6px_#ff2a85]"></div>
        </div>
    </div>

    <!-- Hitmarker -->
    <div id="hitmarker" class="fixed top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 pointer-events-none z-20 opacity-0 transition-opacity duration-75">
        <div class="w-5 h-5 relative">
            <span class="absolute inset-0 border-t-2 border-l-2 border-rose-500 rotate-45"></span>
            <span class="absolute inset-0 border-b-2 border-r-2 border-rose-500 rotate-45"></span>
        </div>
    </div>

    <!-- ================= TOP LEFT: LOGO, STATUS & GRAPHICS SELECTOR ================= -->
    <div class="fixed top-4 left-4 z-30 flex flex-col gap-2.5 max-w-xs sm:max-w-md pointer-events-auto">
        <!-- Brand Header & System Diagnostics -->
        <div class="hud-glass neon-border rounded-2xl px-4 py-2.5 flex items-center gap-3.5">
            <div class="relative flex-shrink-0">
                <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-pink-500 via-purple-600 to-cyan-400 flex items-center justify-center shadow-lg shadow-pink-500/30 border border-white/20">
                    <span class="font-gta font-black text-xl tracking-tighter text-white drop-shadow">VI</span>
                </div>
                <span class="absolute -bottom-1 -right-1 w-3.5 h-3.5 bg-emerald-400 rounded-full border-2 border-slate-950 animate-pulse"></span>
            </div>
            <div class="flex flex-col">
                <div class="flex items-center gap-2">
                    <h1 class="font-gta font-extrabold text-sm sm:text-base tracking-wider bg-gradient-to-r from-pink-400 via-fuchsia-300 to-cyan-300 bg-clip-text text-transparent">
                        LEONIDA VICE
                    </h1>
                    <span id="fps-counter" class="text-[11px] font-bold px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-300 border border-emerald-400/30">
                        60 FPS
                    </span>
                </div>
                <!-- Explicit Verification Badges requested by user -->
                <div class="flex flex-wrap items-center gap-1.5 mt-1 text-[11px] font-bold">
                    <span class="px-2 py-0.5 rounded-md bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 flex items-center gap-1">
                        <i class="fa-solid fa-person-running text-[10px]"></i> MOVERTE: DISPONIBLE
                    </span>
                    <span id="gfx-badge" class="px-2 py-0.5 rounded-md bg-pink-500/25 text-pink-300 border border-pink-500/40 flex items-center gap-1">
                        <i class="fa-solid fa-wand-magic-sparkles text-[10px]"></i> GRÁFICOS: PRO ULTRA MAX
                    </span>
                </div>
            </div>
        </div>

        <!-- Quick Action & Graphics Bar -->
        <div class="hud-glass rounded-xl p-2 flex flex-wrap items-center gap-1.5 text-xs">
            <button id="btn-gfx" onclick="cycleGraphicsQuality()" class="px-2.5 py-1.5 rounded-lg bg-gradient-to-r from-pink-600/80 to-purple-600/80 hover:from-pink-500 hover:to-purple-500 text-white font-bold border border-pink-400/40 transition flex items-center gap-1.5 shadow">
                <i class="fa-solid fa-sliders"></i>
                <span id="btn-gfx-text">Calidad: PRO ULTRA MAX</span>
            </button>
            <button onclick="spawnPlayerSupercar()" class="px-2.5 py-1.5 rounded-lg bg-cyan-500/20 hover:bg-cyan-500/35 text-cyan-300 font-bold border border-cyan-400/30 transition flex items-center gap-1" title="Traer Superdeportivo Neon">
                <i class="fa-solid fa-car-side"></i> +Auto VIP
            </button>
            <button onclick="restoreFullHealth()" class="px-2.5 py-1.5 rounded-lg bg-emerald-500/20 hover:bg-emerald-500/35 text-emerald-300 font-bold border border-emerald-400/30 transition flex items-center gap-1" title="Restaurar Vida = 100">
                <i class="fa-solid fa-heart-pulse"></i> Vida=100
            </button>
            <button onclick="clearWantedLevel()" class="px-2.5 py-1.5 rounded-lg bg-amber-500/20 hover:bg-amber-500/35 text-amber-300 font-bold border border-amber-400/30 transition flex items-center gap-1" title="Limpiar Nivel de Búsqueda">
                <i class="fa-solid fa-shield-halved"></i> 0★
            </button>
            <button onclick="toggleControlsModal()" class="px-2.5 py-1.5 rounded-lg bg-white/10 hover:bg-white/20 text-slate-200 font-bold border border-white/15 transition flex items-center gap-1">
                <i class="fa-solid fa-gamepad"></i> Controles
            </button>
        </div>
    </div>

    <!-- ================= TOP RIGHT: WANTED STARS, MONEY, VIDA = 100 & WEAPONS ================= -->
    <div class="fixed top-4 right-4 z-30 flex flex-col items-end gap-2.5 pointer-events-auto">
        <!-- Wanted Stars + Cash -->
        <div class="hud-glass neon-border rounded-2xl px-4 py-2.5 flex flex-col items-end min-w-[235px]">
            <!-- 5-Star Wanted Row -->
            <div class="flex items-center justify-between w-full mb-1">
                <span class="text-[11px] uppercase tracking-widest text-slate-400 font-bold">Búsqueda Policial</span>
                <div id="wanted-stars" class="flex items-center gap-1 text-lg">
                    <i class="fa-solid fa-star text-slate-700" id="star-1"></i>
                    <i class="fa-solid fa-star text-slate-700" id="star-2"></i>
                    <i class="fa-solid fa-star text-slate-700" id="star-3"></i>
                    <i class="fa-solid fa-star text-slate-700" id="star-4"></i>
                    <i class="fa-solid fa-star text-slate-700" id="star-5"></i>
                </div>
            </div>

            <!-- Money Counter -->
            <div class="flex items-baseline gap-1 font-gta text-2xl sm:text-3xl font-black text-emerald-400 drop-shadow-[0_0_10px_rgba(16,185,129,0.5)]">
                <span>$</span>
                <span id="hud-cash">25,000</span>
            </div>

            <!-- VIDA = 100 BAR (Prominent & Explicit) -->
            <div class="w-full mt-2">
                <div class="flex justify-between items-center text-xs font-extrabold mb-1">
                    <span class="text-rose-400 flex items-center gap-1.5">
                        <i class="fa-solid fa-heart text-rose-500 animate-pulse"></i> VIDA
                    </span>
                    <span id="hud-health-text" class="font-gta text-white text-xs tracking-wider">100 / 100</span>
                </div>
                <div class="w-full h-3 bg-slate-900/90 rounded-full overflow-hidden border border-rose-500/40 p-0.5">
                    <div id="hud-health-bar" class="h-full bg-gradient-to-r from-rose-600 via-pink-500 to-emerald-400 rounded-full transition-all duration-200" style="width: 100%;"></div>
                </div>
            </div>

            <!-- BLINDAJE (Armor) BAR -->
            <div class="w-full mt-2">
                <div class="flex justify-between items-center text-[11px] font-bold mb-1">
                    <span class="text-cyan-400 flex items-center gap-1.5">
                        <i class="fa-solid fa-shield text-cyan-400"></i> BLINDAJE
                    </span>
                    <span id="hud-armor-text" class="font-gta text-cyan-200 text-[11px]">100 / 100</span>
                </div>
                <div class="w-full h-2 bg-slate-900/90 rounded-full overflow-hidden border border-cyan-500/40">
                    <div id="hud-armor-bar" class="h-full bg-gradient-to-r from-blue-500 to-cyan-300 rounded-full transition-all duration-200" style="width: 100%;"></div>
                </div>
            </div>
        </div>

        <!-- Weapon Selector Slots (1 - 4) -->
        <div class="hud-glass rounded-2xl p-2 flex items-center gap-1.5">
            <button onclick="selectWeapon(0)" id="wep-slot-0" class="wep-btn px-3 py-1.5 rounded-xl border border-pink-500/60 bg-pink-500/20 flex flex-col items-center transition">
                <span class="text-[10px] text-slate-300 font-bold">[1]</span>
                <i class="fa-solid fa-hand-fist text-sm text-pink-300 my-0.5"></i>
                <span class="text-[10px] font-bold text-white">Puños</span>
            </button>
            <button onclick="selectWeapon(1)" id="wep-slot-1" class="wep-btn px-3 py-1.5 rounded-xl border border-white/10 bg-white/5 hover:bg-white/10 flex flex-col items-center transition">
                <span class="text-[10px] text-slate-300 font-bold">[2]</span>
                <i class="fa-solid fa-gun text-sm text-cyan-300 my-0.5"></i>
                <span class="text-[10px] font-bold text-white">Pistola</span>
            </button>
            <button onclick="selectWeapon(2)" id="wep-slot-2" class="wep-btn px-3 py-1.5 rounded-xl border border-white/10 bg-white/5 hover:bg-white/10 flex flex-col items-center transition">
                <span class="text-[10px] text-slate-300 font-bold">[3]</span>
                <i class="fa-solid fa-bolt text-sm text-amber-300 my-0.5"></i>
                <span class="text-[10px] font-bold text-white">SMG Neon</span>
            </button>
            <button onclick="selectWeapon(3)" id="wep-slot-3" class="wep-btn px-3 py-1.5 rounded-xl border border-white/10 bg-white/5 hover:bg-white/10 flex flex-col items-center transition">
                <span class="text-[10px] text-slate-300 font-bold">[4]</span>
                <i class="fa-solid fa-rocket text-sm text-rose-400 my-0.5"></i>
                <span class="text-[10px] font-bold text-white">RPG-6</span>
            </button>
        </div>

        <!-- Active Weapon & Ammo Readout -->
        <div class="hud-glass rounded-xl px-3.5 py-1.5 flex items-center gap-3 text-xs">
            <span id="hud-weapon-name" class="font-gta font-bold text-cyan-300">PISTOLA TÁCTICA</span>
            <span class="text-slate-500">|</span>
            <span id="hud-ammo" class="font-gta font-bold text-white">∞ MUNICIÓN</span>
        </div>
    </div>

    <!-- ================= CONTEXTUAL INTERACTION PROMPT (ENTER/EXIT CAR) ================= -->
    <div id="interaction-prompt" class="fixed top-24 left-1/2 -translate-x-1/2 z-30 pointer-events-none opacity-0 transition-all duration-200 transform -translate-y-2">
        <div class="hud-glass neon-border px-5 py-2.5 rounded-2xl flex items-center gap-3 text-sm font-bold text-white shadow-2xl">
            <span class="px-2.5 py-1 rounded-lg bg-pink-500 text-white font-gta text-xs shadow">[F] o [E]</span>
            <span id="interaction-text">Entrar al Vehículo</span>
        </div>
    </div>

    <!-- ================= MISSION / EVENT FEED BANNER ================= -->
    <div id="event-toast" class="fixed top-36 left-1/2 -translate-x-1/2 z-20 pointer-events-none opacity-0 transition-all duration-300">
        <div class="px-4 py-1.5 rounded-full bg-slate-950/85 border border-cyan-400/50 text-cyan-300 font-gta text-xs tracking-wider uppercase shadow-lg">
            <span id="event-toast-text">BIENVENIDO A VICE CITY, LEONIDA</span>
        </div>
    </div>

    <!-- ================= BOTTOM LEFT: RADAR / MINIMAP ================= -->
    <div class="fixed bottom-4 left-4 z-30 flex items-end gap-3 pointer-events-auto">
        <div class="hud-glass neon-border p-2 rounded-2xl relative">
            <canvas id="radar-canvas" width="170" height="170" class="rounded-xl block border border-white/15"></canvas>
            <div class="absolute top-3 left-3 px-2 py-0.5 rounded bg-slate-950/80 text-[10px] font-gta text-pink-400 border border-pink-500/30">
                GPS LEONIDA
            </div>
            <div id="radar-zone" class="absolute bottom-3 left-3 right-3 text-center py-0.5 rounded bg-slate-950/80 text-[10px] font-bold text-cyan-300 tracking-wider uppercase">
                OCEAN DRIVE SUR
            </div>
        </div>

        <!-- Compact Controls Legend -->
        <div class="hidden md:flex hud-glass rounded-2xl px-3.5 py-2.5 flex-col gap-1 text-xs text-slate-300">
            <div class="text-[11px] font-gta text-pink-400 font-bold mb-0.5">CONTROLES RÁPIDOS</div>
            <div><span class="text-white font-bold">W,A,S,D / Flechas:</span> Moverse / Conducir</div>
            <div><span class="text-white font-bold">Shift / Espacio:</span> Correr / Saltar (Freno Mano)</div>
            <div><span class="text-white font-bold">Click Izq / [J]:</span> Disparar / Atacar</div>
            <div><span class="text-white font-bold">[F] o [E]:</span> Subir / Bajar de Vehículo</div>
            <div><span class="text-white font-bold">Ratón o [Q]/[E]:</span> Girar Cámara 360°</div>
        </div>
    </div>

    <!-- ================= BOTTOM RIGHT: SPEEDOMETER (VISIBLE WHEN DRIVING) ================= -->
    <div id="speedometer-hud" class="fixed bottom-4 right-4 z-30 pointer-events-none opacity-0 transition-all duration-300 translate-y-4">
        <div class="hud-glass neon-border rounded-2xl px-5 py-3 flex items-center gap-4">
            <div class="flex flex-col items-end">
                <span id="vehicle-name-hud" class="font-gta text-xs text-pink-400 font-bold tracking-wider">CHEETAH VICE GT</span>
                <div class="flex items-baseline gap-1.5">
                    <span id="speed-value" class="font-gta text-4xl font-black text-white neon-text-cyan">0</span>
                    <span class="font-gta text-xs text-slate-400">KM/H</span>
                </div>
                <div class="w-32 h-2 bg-slate-900 rounded-full overflow-hidden mt-1 border border-white/10">
                    <div id="speed-bar" class="h-full bg-gradient-to-r from-cyan-400 via-fuchsia-500 to-rose-500 transition-all duration-75" style="width: 0%;"></div>
                </div>
            </div>
            <button onclick="exitCurrentVehicle()" class="pointer-events-auto px-3 py-2 rounded-xl bg-rose-500/25 hover:bg-rose-500/40 border border-rose-400/40 text-rose-200 text-xs font-bold">
                Salir [F]
            </button>
        </div>
    </div>

    <!-- ================= MOBILE / TOUCH ON-SCREEN CONTROLS ================= -->
    <div id="touch-controls" class="fixed bottom-4 inset-x-0 z-30 flex md:hidden justify-between items-end px-4 pointer-events-none">
        <!-- D-Pad -->
        <div class="grid grid-cols-3 gap-1.5 pointer-events-auto bg-slate-950/60 p-2 rounded-2xl border border-white/15 backdrop-blur">
            <div></div>
            <button id="t-up" class="w-12 h-12 rounded-xl bg-white/15 active:bg-pink-500 flex items-center justify-center text-lg"><i class="fa-solid fa-chevron-up"></i></button>
            <div></div>
            <button id="t-left" class="w-12 h-12 rounded-xl bg-white/15 active:bg-pink-500 flex items-center justify-center text-lg"><i class="fa-solid fa-chevron-left"></i></button>
            <button id="t-down" class="w-12 h-12 rounded-xl bg-white/15 active:bg-pink-500 flex items-center justify-center text-lg"><i class="fa-solid fa-chevron-down"></i></button>
            <button id="t-right" class="w-12 h-12 rounded-xl bg-white/15 active:bg-pink-500 flex items-center justify-center text-lg"><i class="fa-solid fa-chevron-right"></i></button>
        </div>
        <!-- Action Buttons -->
        <div class="flex flex-col gap-2 pointer-events-auto">
            <div class="flex gap-2">
                <button onclick="interactWithVehicle()" class="w-14 h-12 rounded-xl bg-cyan-500/30 border border-cyan-400/50 text-cyan-200 font-bold text-xs flex flex-col items-center justify-center">
                    <i class="fa-solid fa-car"></i><span>Auto</span>
                </button>
                <button id="t-jump" class="w-14 h-12 rounded-xl bg-purple-500/30 border border-purple-400/50 text-purple-200 font-bold text-xs flex flex-col items-center justify-center">
                    <i class="fa-solid fa-bolt"></i><span>Salto</span>
                </button>
            </div>
            <button id="t-shoot" class="w-28 h-14 rounded-2xl bg-gradient-to-r from-rose-600 to-pink-500 text-white font-gta font-bold text-sm shadow-lg shadow-rose-500/40 flex items-center justify-center gap-2">
                <i class="fa-solid fa-crosshairs"></i> FUEGO
            </button>
        </div>
    </div>

    <!-- ================= WASTED ("ELIMINADO") OVERLAY ================= -->
    <div id="wasted-screen" class="fixed inset-0 z-50 bg-slate-950/90 backdrop-blur-md hidden flex-col items-center justify-center text-center p-6">
        <h2 class="font-gta text-6xl sm:text-8xl font-black text-rose-600 tracking-widest drop-shadow-[0_0_35px_rgba(225,29,72,0.9)] animate-pulse">
            ELIMINADO
        </h2>
        <p class="text-slate-300 text-lg sm:text-xl mt-3 max-w-md">
            Los paramédicos del Hospital General de Vice Beach te han reconstruido.
        </p>
        <div class="mt-6 px-5 py-2.5 rounded-xl bg-emerald-500/20 border border-emerald-400/40 text-emerald-300 font-bold text-sm">
            VIDA RESTAURADA A 100 / 100 • BLINDAJE 100 / 100
        </div>
        <button onclick="respawnPlayer()" class="mt-8 px-8 py-4 rounded-2xl bg-gradient-to-r from-pink-500 via-fuchsia-500 to-cyan-400 text-white font-gta font-black text-lg tracking-wider shadow-[0_0_30px_rgba(255,42,133,0.6)] hover:scale-105 transition">
            REAPARECER AHORA
        </button>
    </div>

    <!-- ================= CONTROLS & HELP MODAL ================= -->
    <div id="controls-modal" class="fixed inset-0 z-50 bg-slate-950/80 backdrop-blur-md hidden items-center justify-center p-4">
        <div class="hud-glass neon-border rounded-3xl max-w-lg w-full p-6 border border-pink-500/40 text-left relative">
            <button onclick="toggleControlsModal()" class="absolute top-4 right-4 w-9 h-9 rounded-xl bg-white/10 hover:bg-rose-500/40 flex items-center justify-center text-white">
                <i class="fa-solid fa-xmark"></i>
            </button>
            <div class="flex items-center gap-3 mb-4">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-pink-500 to-cyan-400 flex items-center justify-center font-gta font-black text-lg">VI</div>
                <div>
                    <h3 class="font-gta font-bold text-xl text-white">MANUAL DE LEONIDA</h3>
                    <p class="text-xs text-cyan-300">Vida = 100 • Moverte = Disponible • Gráficos = Pro Ultra Max</p>
                </div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm text-slate-200">
                <div class="p-3 rounded-xl bg-white/5 border border-white/10">
                    <div class="text-pink-400 font-bold text-xs uppercase mb-1">Movimiento a Pie</div>
                    <p><b>W, A, S, D / Flechas:</b> Caminar</p>
                    <p><b>Shift:</b> Esprintar rápido</p>
                    <p><b>Espacio:</b> Saltar</p>
                </div>
                <div class="p-3 rounded-xl bg-white/5 border border-white/10">
                    <div class="text-cyan-400 font-bold text-xs uppercase mb-1">Combate y Cámara</div>
                    <p><b>Click en Pantalla:</b> Cámara Ratón 360°</p>
                    <p><b>Click Izq / [J]:</b> Disparar arma</p>
                    <p><b>Teclas 1, 2, 3, 4:</b> Cambiar Armas</p>
                </div>
                <div class="p-3 rounded-xl bg-white/5 border border-white/10">
                    <div class="text-amber-400 font-bold text-xs uppercase mb-1">Vehículos</div>
                    <p><b>[F] o [E]:</b> Robar / Salir del auto</p>
                    <p><b>Espacio:</b> Derrape (Freno de mano)</p>
                    <p><b>[H]:</b> Claxon / Bocina</p>
                </div>
                <div class="p-3 rounded-xl bg-white/5 border border-white/10">
                    <div class="text-emerald-400 font-bold text-xs uppercase mb-1">Mundo Abierto</div>
                    <p><b>Billetes Verdes:</b> +$500 Efectivo</p>
                    <p><b>Corazones Rosas:</b> Curar Vida = 100</p>
                    <p><b>Barriles Rojos:</b> Explosivos</p>
                </div>
            </div>

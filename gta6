            // Neon Underglow Strip
            const underglowMat = new THREE.MeshBasicMaterial({
                color: isPolice ? 0x00f0ff : 0xff2a85
            });
            const underglow = new THREE.Mesh(new THREE.PlaneGeometry(2.1, 4.2), underglowMat);
            underglow.rotation.x = Math.PI / 2;
            underglow.position.y = 0.12;
            carGroup.add(underglow);

            // Headlights (Front +Z)
            const headLightMat = new THREE.MeshBasicMaterial({ color: 0xccf7ff });
            const hlLeft = new THREE.Mesh(new THREE.BoxGeometry(0.42, 0.2, 0.1), headLightMat);
            hlLeft.position.set(-0.75, 0.78, 2.36);
            const hlRight = hlLeft.clone();
            hlRight.position.x = 0.75;
            carGroup.add(hlLeft, hlRight);

            // Taillights (Rear -Z)
            const tailMat = new THREE.MeshBasicMaterial({ color: 0xff0055 });
            const tailBar = new THREE.Mesh(new THREE.BoxGeometry(2.0, 0.18, 0.1), tailMat);
            tailBar.position.set(0, 0.82, -2.36);
            carGroup.add(tailBar);

            // 4 Wheels
            const wheelGeo = new THREE.CylinderGeometry(0.42, 0.42, 0.32, 14);
            wheelGeo.rotateZ(Math.PI / 2);
            const wheelMat = new THREE.MeshStandardMaterial({ color: 0x0f172a, roughness: 0.8 });
            const wheelPositions = [
                [-1.15, 0.42, 1.45],
                [1.15, 0.42, 1.45],
                [-1.15, 0.42, -1.45],
                [1.15, 0.42, -1.45]
            ];
            wheelPositions.forEach(([wx, wy, wz]) => {
                const w = new THREE.Mesh(wheelGeo, wheelMat);
                w.position.set(wx, wy, wz);
                carGroup.add(w);
            });

            // Police Lightbar if police
            let sirenRed = null, sirenBlue = null;

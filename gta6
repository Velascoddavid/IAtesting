                const roadCoord = roadIndex * CELL_SIZE - CELL_SIZE / 2;
                const alongZ = i % 2 === 0;
                if (alongZ) {
                    carGroup.position.set(roadCoord + 3.5, 0, (Math.random() - 0.5) * 240);

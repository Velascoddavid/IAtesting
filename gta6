        // --- PARTICLE EFFECTS SYSTEM ---
        function spawnParticles(pos, colorHex, count = 12, speedScale = 8, size = 0.28) {
            const maxMultiplier = gameState.graphicsMode === 'RENDIMIENTO' ? 0.4 : (gameState.graphicsMode === 'ALTO' ? 0.75 : 1.2);
            const total = Math.max(3, Math.floor(count * maxMultiplier));
            const geo = new THREE.BoxGeometry(size, size, size);
            const mat = new THREE.MeshBasicMaterial({ color: colorHex });

            for (let i = 0; i < total; i++) {
                const p = new THREE.Mesh(geo, mat);
                p.position.copy(pos);
                const vel = new THREE.Vector3(
                    (Math.random() - 0.5) * speedScale,
                    Math.random() * speedScale * 0.8 + 1.5,
                    (Math.random() - 0.5) * speedScale
                );
                scene.add(p);
                particles.push({ mesh: p, vel, life: 0.45 + Math.random() * 0.35 });
            }
        }

        function triggerExplosion(pos) {
            sfx.playExplosion();
            spawnParticles(pos, 0xff5500, 28, 18, 0.55);
            spawnParticles(pos, 0xffd000, 18, 14, 0.4);
            increaseWantedLevel(1);

            // Damage nearby NPCs, vehicles, and player
            npcs.forEach(npc => {
                if (npc.alive && npc.mesh.position.distanceTo(pos) < 11) {
                    killNPC(npc);
                }
            });

            vehicles.forEach(v => {
                if (v.mesh.position.distanceTo(pos) < 10) {
                    v.speed = -12;
                    spawnParticles(v.mesh.position, 0x333333, 10, 6, 0.4);
                }
            });

            const distToPlayer = playerGroup.position.distanceTo(pos);
            if (distToPlayer < 9) {
                applyPlayerDamage(Math.floor((9 - distToPlayer) * 4));
            }
        }

        // --- PLAYER COMBAT & WEAPONS ---
        function selectWeapon(index) {
            if (index < 0 || index >= WEAPONS.length) return;
            gameState.currentWeapon = index;
            const wep = WEAPONS[index];

            // Update HUD weapon slots
            for (let i = 0; i < 4; i++) {
                const btn = document.getElementById(`wep-slot-${i}`);
                if (i === index) {
                    btn.className = 'wep-btn px-3 py-1.5 rounded-xl border border-pink-500 bg-pink-500/30 flex flex-col items-center transition scale-105';
                } else {
                    btn.className = 'wep-btn px-3 py-1.5 rounded-xl border border-white/10 bg-white/5 hover:bg-white/10 flex flex-col items-center transition';
                }
            }
            document.getElementById('hud-weapon-name').textContent = wep.name;
            document.getElementById('hud-ammo').textContent = wep.ammoText;

            if (weaponMesh) {
                weaponMesh.visible = index !== 0;
                weaponMesh.scale.set(1, 1, index === 3 ? 1.8 : 1);
            }
        }

        function fireWeapon() {
            if (gameState.isWasted || gameState.inVehicle) return;
            const now = performance.now() / 1000;
            const wep = WEAPONS[gameState.currentWeapon];
            if (now - gameState.lastShotTime < wep.rate) return;
            gameState.lastShotTime = now;

            // Crosshair recoil animation
            const ring = document.getElementById('crosshair-ring');
            ring.style.transform = 'scale(1.38)';
            setTimeout(() => { ring.style.transform = 'scale(1)'; }, 85);

            // Rotate player toward camera look direction when firing
            playerGroup.rotation.y = gameState.cameraYaw + Math.PI;

            const muzzlePos = playerGroup.position.clone().add(new THREE.Vector3(0, 1.6, 0));
            const forward = new THREE.Vector3(
                -Math.sin(gameState.cameraYaw),
                -Math.sin(gameState.cameraPitch) * 0.35,
                -Math.cos(gameState.cameraYaw)
            ).normalize();

            sfx.playShot(wep.type);
            spawnParticles(muzzlePos.clone().add(forward.clone().multiplyScalar(0.9)), wep.color, 5, 5, 0.16);

            // Trigger panic in nearby pedestrians
            npcs.forEach(npc => {
                if (npc.alive && npc.mesh.position.distanceTo(playerGroup.position) < 35) {
                    npc.panicTimer = 8;
                }
            });

            // RPG Rocket Projectile
            if (wep.type === 'rpg') {
                const rocketMesh = new THREE.Mesh(
                    new THREE.CylinderGeometry(0.14, 0.14, 0.9, 8),
                    new THREE.MeshBasicMaterial({ color: 0xff3300 })
                );
                rocketMesh.rotation.x = Math.PI / 2;
                rocketMesh.position.copy(muzzlePos).add(forward.clone().multiplyScalar(1.4));
                scene.add(rocketMesh);
                rockets.push({
                    mesh: rocketMesh,
                    vel: forward.clone().multiplyScalar(55),
                    life: 2.5
                });
                return;
            }

            // Instant Raycast / Hitscan for Melee, Pistol & SMG
            const raycaster = new THREE.Raycaster(muzzlePos, forward, 0.2, wep.range);

            // Check Explosive Barrels
            for (const barrel of explosiveBarrels) {
                if (!barrel.active) continue;
                const hits = raycaster.intersectObject(barrel.mesh, true);
                if (hits.length > 0) {
                    barrel.active = false;
                    barrel.mesh.visible = false;
                    showHitmarker();
                    triggerExplosion(barrel.mesh.position);
                    return;
                }
            }

            // Check NPCs
            for (const npc of npcs) {
                if (!npc.alive) continue;
                const hits = raycaster.intersectObject(npc.mesh, true);
                if (hits.length > 0) {
                    showHitmarker();
                    spawnParticles(hits[0].point, 0xff0055, 8, 6, 0.18);
                    npc.health -= wep.damage;
                    if (npc.health <= 0) {
                        killNPC(npc);
                        increaseWantedLevel(1);
                    }
                    return;
                }
            }

            // Check Police Units
            for (const cop of policeUnits) {
                const hits = raycaster.intersectObject(cop.mesh, true);
                if (hits.length > 0) {
                    showHitmarker();
                    spawnParticles(hits[0].point, 0x00f0ff, 10, 8, 0.22);
                    cop.health -= wep.damage;
                    increaseWantedLevel(1);
                    if (cop.health <= 0) {
                        triggerExplosion(cop.mesh.position);
                        cop.mesh.position.set(999, -50, 999);
                    }
                    return;
                }
            }

            // Visual Laser Tracer for Pistol & SMG
            if (wep.type !== 'melee') {
                const endPoint = muzzlePos.clone().add(forward.clone().multiplyScalar(32));
                spawnParticles(endPoint, wep.color, 4, 4, 0.15);
            }
        }

        function killNPC(npc) {
            if (!npc.alive) return;
            npc.alive = false;
            npc.mesh.rotation.x = -Math.PI / 2;
            npc.mesh.position.y = 0.2;
            // Drop cash reward
            addCash(250);
            createPickup(npc.mesh.position.x, npc.mesh.position.z, 'cash');
        }

        function showHitmarker() {
            const hm = document.getElementById('hitmarker');
            hm.style.opacity = '1';
            setTimeout(() => { hm.style.opacity = '0'; }, 95);
        }

        // --- VEHICLE ENTER / EXIT & VIP CAR SPAWN ---
        function findNearestVehicle(maxDist = 6.2) {
            let nearest = null;
            let bestDist = maxDist;
            for (const v of vehicles) {
                const d = v.mesh.position.distanceTo(playerGroup.position);
                if (d < bestDist) {
                    bestDist = d;
                    nearest = v;
                }
            }
            for (const cop of policeUnits) {
                const d = cop.mesh.position.distanceTo(playerGroup.position);
                if (d < bestDist) {
                    bestDist = d;
                    nearest = cop;
                }
            }
            return nearest;
        }

        function interactWithVehicle() {
            if (gameState.isWasted) return;
            if (gameState.inVehicle) {
                exitCurrentVehicle();
            } else {
                const targetCar = findNearestVehicle(6.5);
                if (targetCar) {
                    gameState.inVehicle = targetCar;
                    targetCar.isAI = false;
                    playerGroup.visible = false;
                    document.getElementById('speedometer-hud').style.opacity = '1';
                    document.getElementById('speedometer-hud').style.transform = 'translateY(0)';
                    document.getElementById('vehicle-name-hud').textContent = targetCar.name || 'PATRULLA LEONIDA PD';
                    showToast(`CONDUCIENDO: ${targetCar.name || 'PATRULLA POLICIAL'}`);
                    if (targetCar.isPolice) {
                        increaseWantedLevel(2);
                    }
                }
            }
        }

        function exitCurrentVehicle() {
            if (!gameState.inVehicle) return;
            const car = gameState.inVehicle;
            const sideOffset = new THREE.Vector3(-2.4, 0, 0).applyAxisAngle(new THREE.Vector3(0, 1, 0), car.mesh.rotation.y);
            playerGroup.position.copy(car.mesh.position).add(sideOffset);
            playerGroup.position.y = 0.3;
            playerGroup.visible = true;
            gameState.inVehicle = null;
            document.getElementById('speedometer-hud').style.opacity = '0';
            document.getElementById('speedometer-hud').style.transform = 'translateY(16px)';
        }

        function spawnPlayerSupercar() {
            if (gameState.isWasted) return;
            const forward = new THREE.Vector3(-Math.sin(gameState.cameraYaw), 0, -Math.cos(gameState.cameraYaw));
            const spawnPos = (gameState.inVehicle ? gameState.inVehicle.mesh.position : playerGroup.position)
                .clone()
                .add(forward.multiplyScalar(6));
            const { carGroup } = createVehicleMesh(0x00f0ff, false);
            carGroup.position.set(spawnPos.x, 0, spawnPos.z);
            carGroup.rotation.y = gameState.cameraYaw + Math.PI;
            const newCar = {
                mesh: carGroup,
                name: 'LEONIDA HYPER-VI PRO',
                speed: 0,
                maxSpeed: 54,
                steering: 0,
                isAI: false,
                isPolice: false,
                health: 150
            };
            vehicles.push(newCar);
            spawnParticles(spawnPos, 0x00f0ff, 18, 8, 0.3);
            sfx.playPickup();
            showToast('SUPERDEPORTIVO VIP ENTREGADO');
